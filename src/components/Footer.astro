---
import Image from './Image.astro';
import FooterLogo from '../assets/img/bridge-logo.png'; 
---

<footer class="bg-primary-back text-primary text-sm pt-12 pb-12 md:px-12 px-4 border-t border-gray-300">
  <div class="max-w-7xl mx-auto">
    <!-- ロゴと社名 横並び -->
     <a href="/">
    <div class="flex items-center mb-2">
      <Image
        src={FooterLogo}
        alt="Bridge"
        class="h-16 w-auto mr-3"
        loading="lazy"
        decoding="async"
      />
    </div>
    </a>
    <!-- フッタークレジット -->
    <div class="mt-10 text-xs text-center text-gray-900">
      ©　株式会社Bridge All Rights Reserved.
    </div>
  </div>
</footer>
